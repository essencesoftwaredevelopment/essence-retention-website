# Environment variables

## Required
LEADS_API_BASE_URL=https://your-leads-api.example.com

## VSL (Mux)
# Public playback ID only — safe for the client bundle.
# Upload the master VSL in the Mux dashboard, then paste the Playback ID here.
NEXT_PUBLIC_VSL_PLAYBACK_ID=
# Alias also supported:
# VSL_PLAYBACK_ID=

# NEVER put these in frontend env / client code:
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
